# Copiar a .env para desarrollo local (nunca versionar .env)

# PostgreSQL
POSTGRES_DB=ephemeral
POSTGRES_USER=ephemeral
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# API FastAPI
API_PORT=8000
APP_ENV=development

# Seguridad (parámetros del documento de diseño E1)
TOKEN_TTL_MINUTES=60
ARGON2_MAX_CONCURRENCY=4
LOGIN_RATE_LIMIT_PER_MIN=5

# Modo red team (none | swap_spk | swap_identity)
MALICIOUS_MODE=none
